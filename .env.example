# Configuration de l'environnement
# Copier ce fichier en .env et modifier les valeurs selon votre environnement

# ===========================================
# DÉVELOPPEMENT LOCAL
# ===========================================

# Django
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# PRODUCTION (PythonAnywhere)
# ===========================================
# Décommentez et modifiez ces lignes pour la production

# SECRET_KEY=votre-cle-secrete-de-production-differente-et-securisee
# DEBUG=False
# ALLOWED_HOSTS=votre-username.pythonanywhere.com

# ===========================================
# BASE DE DONNÉES (optionnel)
# ===========================================

# Par défaut: SQLite (suffisant pour la plupart des cas)
# Pas de configuration nécessaire

# Pour PostgreSQL (exemple)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sondage_db
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# Pour MySQL sur PythonAnywhere (compte payant)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=votre_username$nom_db
# DB_USER=votre_username
# DB_PASSWORD=votre_mot_de_passe
# DB_HOST=votre_username.mysql.pythonanywhere-services.com

# ===========================================
# EMAIL (optionnel)
# ===========================================

# Pour Gmail
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre@email.com
# EMAIL_HOST_PASSWORD=votre_mot_de_passe_application

# ===========================================
# NOTES IMPORTANTES
# ===========================================
# 
# 1. Ne commitez JAMAIS ce fichier avec de vraies valeurs !
# 2. Sur PythonAnywhere, créez un fichier .env à la racine du projet
# 3. Générez une SECRET_KEY sécurisée avec:
#    python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# 4. En production, assurez-vous que DEBUG=False
# 5. Consultez DEPLOIEMENT_PYTHONANYWHERE.md pour plus de détails
