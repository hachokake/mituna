# Variables d'environnement pour PythonAnywhere
# Copiez ce fichier vers .env sur votre serveur PythonAnywhere
# NE COMMITEZ JAMAIS CE FICHIER AVEC DE VRAIES VALEURS !

# 🔐 SECRET KEY
# Générez une nouvelle clé avec cette commande :
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=votre-cle-secrete-super-longue-et-aleatoire-a-generer

# 🐛 DEBUG MODE (False en production)
DEBUG=False

# 🌐 ALLOWED HOSTS
# Remplacez 'votre-username' par votre nom d'utilisateur PythonAnywhere
ALLOWED_HOSTS=votre-username.pythonanywhere.com

